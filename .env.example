# MLflow
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_NAME=titanic-survival
MODEL_NAME=titanic-survival-classifier
MIN_F1_SCORE=0.70

# Training
DATA_PATH=data/raw/titanic_data.csv
RANDOM_STATE=42
TEST_SIZE=0.2

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=passenger.events
KAFKA_TOPIC_PREDICTIONS=survival.predictions
KAFKA_TOPIC_DLQ=survival.dlq
KAFKA_GROUP_ID=titanic-survival-consumer

# BentoML
BENTO_SERVICE_URL=http://localhost:3000
MODEL_VERSION=Production

# Monitoring
DRIFT_PSI_THRESHOLD=0.25
BASELINE_PREDICTION_RATE=0.38
