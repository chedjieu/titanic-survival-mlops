{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassengerEvent",
  "type": "object",
  "required": ["event_id", "Pclass", "Sex"],
  "properties": {
    "event_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "passenger_id": { "type": ["string", "null"] },
    "Pclass": { "type": "integer", "minimum": 1, "maximum": 3 },
    "Sex": { "type": "string", "enum": ["male", "female"] },
    "Age": { "type": ["number", "null"] },
    "SibSp": { "type": "integer", "minimum": 0 },
    "Parch": { "type": "integer", "minimum": 0 },
    "Fare": { "type": ["number", "null"] },
    "Embarked": { "type": ["string", "null"], "enum": ["C", "Q", "S", null] },
    "ts": { "type": "number" }
  },
  "additionalProperties": false
}
